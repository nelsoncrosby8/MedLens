# Copy to backend/.env and fill in real values. backend/.env is gitignored.

# SQLAlchemy database URL. Matches the docker-compose `db` service / local Postgres role.
DATABASE_URL=postgresql+psycopg2://medlens:medlens@localhost:5432/medlens

# JWT signing secret — generate a long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=replace-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# JSON array of browser origins allowed to call the API (CORS).
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
