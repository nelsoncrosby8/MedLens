# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Environment / secrets
.env
.env.*
!.env.example

# Trained model artifacts (regenerate via backend/app/ml/export_weights.py)
backend/app/ml/weights/*.h5
backend/app/ml/weights/*.keras

# Datasets — never commit image data (rule scoped to a top-level data/ dir only,
# so backend/tests/data/ sample fixtures are still tracked)
/data/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/
